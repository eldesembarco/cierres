// IMPORTANTE: esta app NO es dueña del schema de la base. Comparte la Neon DB
// (schema "cierres") con la app de cierres, que es quien corre las migraciones.
// Acá solo se declaran los modelos que el BI consume, para generar el cliente.
// NUNCA correr `prisma migrate` desde este proyecto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  encargado
  central
  admin
  contable
}

model Usuario {
  id           Int     @id @default(autoincrement())
  nombre       String
  email        String  @unique
  passwordHash String  @map("password_hash")
  rol          Rol
  localId      Int?    @map("local_id")
  activo       Boolean @default(true)
  @@map("usuarios")
}

model Marca {
  id      Int     @id @default(autoincrement())
  nombre  String  @unique
  activo  Boolean @default(true)
  locales Local[]
  @@map("marcas")
}

model Local {
  id                  Int                  @id @default(autoincrement())
  nombre              String
  marca               Marca                @relation(fields: [marcaId], references: [id])
  marcaId             Int                  @map("marca_id")
  tangoSucursalId     Int?                 @unique @map("tango_sucursal_id")
  activo              Boolean              @default(true)
  ventasTangoHora     VentaTangoHora[]
  ventasTangoArticulo VentaTangoArticulo[]
  consumosInsumoTango ConsumoInsumoTango[]
  comandasAnuladasTango ComandaAnuladaTango[]
  @@map("locales")
}

// URL viva del bridge de Tango: la registra el propio bridge al levantar su túnel
// (POST /api/tango/bridge-url de la app cierres). Tabla migrada por cierres; acá
// solo se lee para resolver dónde está el bridge ahora.
model TangoBridge {
  id            Int      @id
  url           String
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  @@map("tango_bridge")
}

// Agregados de venta REAL de Tango (facturada, definición Z, neta de NC).
// Sincronizados desde el bridge; NO desde /cobros (universo más chico).
// Desde 2026-07-16 la clave es la SUCURSAL de Tango (propias y franquicias);
// localId queda solo como link a los locales propios de cierres.

// Dimensión de sucursales de Tango. Seed inicial desde CENTRAL_ESTADISTICA.SUCURSAL;
// el sync auto-crea las que aparezcan después. `esPropia` alimenta el selector
// Propios/Franquicias/Todos del BI.
model SucursalTango {
  id       Int     @id // ID_SUCURSAL de Tango
  nombre   String
  marca    String  @default("D") // 'D' Desembarco | 'T' Tasty/Mila&Go
  esPropia Boolean @default(false) @map("es_propia")
  localId  Int?    @unique @map("local_id")
  ventasTangoHora       VentaTangoHora[]
  ventasTangoArticulo   VentaTangoArticulo[]
  consumosInsumoTango   ConsumoInsumoTango[]
  comandasAnuladasTango ComandaAnuladaTango[]
  @@map("sucursal_tango")
}

model VentaTangoHora {
  id         Int            @id @default(autoincrement())
  local      Local?         @relation(fields: [localId], references: [id])
  localId    Int?           @map("local_id")
  sucursal   SucursalTango? @relation(fields: [sucursalId], references: [id])
  sucursalId Int?           @map("sucursal_id")
  fecha      DateTime       @db.Date
  hora       Int
  monto      Decimal        @default(0) @db.Decimal(14, 2)
  tickets    Int            @default(0)
  @@unique([sucursalId, fecha, hora])
  @@index([fecha])
  @@map("venta_tango_hora")
}

model VentaTangoArticulo {
  id          Int            @id @default(autoincrement())
  local       Local?         @relation(fields: [localId], references: [id])
  localId     Int?           @map("local_id")
  sucursal    SucursalTango? @relation(fields: [sucursalId], references: [id])
  sucursalId  Int?           @map("sucursal_id")
  fecha       DateTime       @db.Date
  codigo      String
  descripcion String
  rubro       String?
  cantidad    Decimal        @default(0) @db.Decimal(14, 3)
  monto       Decimal        @default(0) @db.Decimal(14, 2)
  @@unique([sucursalId, fecha, codigo])
  @@index([fecha])
  @@map("venta_tango_articulo")
}

// Consumo de insumos (materia prima/empaque) por local/fecha, desde vw_ConsumoInsumos.
model ConsumoInsumoTango {
  id            Int            @id @default(autoincrement())
  local         Local?         @relation(fields: [localId], references: [id])
  localId       Int?           @map("local_id")
  sucursal      SucursalTango? @relation(fields: [sucursalId], references: [id])
  sucursalId    Int?           @map("sucursal_id")
  fecha         DateTime       @db.Date
  codigo        String
  descripcion   String
  rubro         String?
  unidad        String?
  cantidad      Decimal        @default(0) @db.Decimal(14, 3)
  // Valorización al precio de reposición de Tango (STA12); null = sin costo cargado.
  costoUnitario Decimal? @map("costo_unitario") @db.Decimal(14, 4)
  costoTotal    Decimal? @map("costo_total") @db.Decimal(14, 2)
  @@unique([sucursalId, fecha, codigo])
  @@index([fecha])
  @@map("consumo_insumo_tango")
}

// Comandas anuladas en Tango (ESTADO='X'), para la auditoría de anulaciones del
// BI. Sin clave natural: el resync borra y reinserta por fecha.
model ComandaAnuladaTango {
  id         Int            @id @default(autoincrement())
  local      Local?         @relation(fields: [localId], references: [id])
  localId    Int?           @map("local_id")
  sucursal   SucursalTango? @relation(fields: [sucursalId], references: [id])
  sucursalId Int?           @map("sucursal_id")
  fecha      DateTime       @db.Date
  fechaHora  DateTime       @map("fecha_hora")
  importe    Decimal        @default(0) @db.Decimal(14, 2)
  tipoPedido String?        @map("tipo_pedido")
  cubiertos  Int            @default(0)
  @@index([fecha])
  @@index([localId, fecha])
  @@index([sucursalId, fecha])
  @@map("comanda_anulada_tango")
}

model VentaTangoSync {
  id             Int      @id @default(autoincrement())
  fecha          DateTime @unique @db.Date
  filasHoras     Int      @default(0) @map("filas_horas")
  filasArticulos Int      @default(0) @map("filas_articulos")
  filasInsumos   Int      @default(0) @map("filas_insumos")
  filasAnuladas  Int      @default(0) @map("filas_anuladas")
  sincronizadoEn DateTime @default(now()) @map("sincronizado_en")
  @@map("venta_tango_sync")
}
