                "name": "Preparar Notificacion",
                "type": "n8n-nodes-base.code",
                "typeVersion": 2,
                "position": [
                    440,
                    200
                ],
                "parameters": {
                    "jsCode": "// Notifica una sola vez por card resuelta, al chat de WhatsApp de origen.\nconst sd = $getWorkflowStaticData('global');\nif (!Array.isArray(sd.notified)) sd.notified = [];\nconst out = [];\nfor (const item of $input.all()) {\n  const c = item.json;\n  if (!c || !c.id) continue;\n  if (sd.notified.includes(c.id)) continue;\n  sd.notified.push(c.id);\n  if (sd.notified.length > 500) sd.notified = sd.notified.slice(-400);\n  const mChat = (c.desc || '').match(/\\*\\*Chat:\\*\\* ([^\\s\\n]+)/);\n  if (!mChat) continue; // card creada a mano, sin origen WhatsApp\n  const mSol = (c.desc || '').match(/\\*\\*Solicitante:\\*\\* ([^\\s\\n]+)/);\n  out.push({ json: {\n    cardId: c.id,\n    recipient: mChat[1],\n    message: `\u00e2\u0153\u2026 Resuelto: ${c.name}\\n${c.shortUrl}${mSol ? '\\n(solicitado por ' + mSol[1] + ')' : ''}`\n  } });\n}\nreturn out;"
                }
            },
