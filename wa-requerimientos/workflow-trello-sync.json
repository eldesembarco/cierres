        {
            "id": "code-bajar-adjuntos",
            "name": "Bajar Adjuntos Mesa",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                880,
                -220
            ],
            "parameters": {
                "jsCode": "// Descarga TODOS los adjuntos de la card y los deja como binarios data0..dataN.\nconst OAUTH = 'OAuth oauth_consumer_key=\"0e2126dbfd8ca7c38318c2570e7bf532\", oauth_token=\"ATTAac89aa35c1107c9ad5684977c731d18e375ec585f2e3e3bfbf84606bedaa3793FE3A3525\"';\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const binary = {};\n  const props = [];\n  for (let i = 0; i < (j.attList || []).length; i++) {\n    const a = j.attList[i];\n    try {\n      const resp = await this.helpers.httpRequest({ method: 'GET', url: a.url, headers: { Authorization: OAUTH }, encoding: 'arraybuffer', timeout: 60000 });\n      binary['data' + i] = await this.helpers.prepareBinaryData(Buffer.from(resp), a.name, a.mime);\n      props.push('data' + i);\n    } catch (e) { /* adjunto que no baja no frena el email */ }\n  }\n  out.push({ json: { ...j, binaryProps: props.join(',') }, binary });\n}\nreturn out;"
            }
        },
        {
            "id": "code-marcar-enviado",
            "name": "Marcar Enviado",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1320,
                -120
            ],
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "// La card se queda en la columna 'Pas\u00c3\u00b3 a...'; este registro evita reenv\u00c3\u00ados del cron.\nconst sd = $getWorkflowStaticData('global');\nif (!Array.isArray(sd.sentMesa)) sd.sentMesa = [];\nconst src = $('Preparar Email').item.json;\nif (!sd.sentMesa.includes(src.cardId)) sd.sentMesa.push(src.cardId);\nif (sd.sentMesa.length > 300) sd.sentMesa = sd.sentMesa.slice(-200);\nreturn { json: src };"
            }
        }
