        {
            "id": "code-email",
            "name": "Preparar Email",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                440,
                -120
            ],
            "parameters": {
                "jsCode": "// Mesas de ayuda por columna de Trello. Destinos HOY apuntan al mail de Pablo\n// hasta tener las casillas reales (Tango/Axoft y Ayres IT).\nconst MESAS = {\n  '6a689b2b078eec227dc02ea5': { mesa: 'Mesa de Ayuda Tango', destino: 'mesadeayuda@seincomp.com.ar' },\n  '6a689bcabc131c785ef97206': { mesa: 'Mesa de Ayuda Ayres IT', destino: 'polejavetzky@eldesembarco.com' }\n};\nconst sd = $getWorkflowStaticData('global');\nif (!Array.isArray(sd.sentMesa)) sd.sentMesa = [];\nconst out = [];\nfor (const item of $input.all()) {\n  const c = item.json;\n  if (!c || !c.id) continue;\n  if (sd.sentMesa.includes(c.id)) continue; // ya enviado: la card se queda en la columna sin reenviar\n  const cfg = MESAS[c.idList] || { mesa: 'Mesa de ayuda', destino: 'polejavetzky@eldesembarco.com' };\n  const atts = (c.attachments || []).filter(a => a.url && a.isUpload !== false);\n  const nombre = (c.name || '').replace(/^[^0-9A-Za-z\\[\u00c3\u20ac-\u00c5\u00bf]+\\s*/, '');\n  const cuerpo = [\n    'Estimados,',\n    '',\n    'Solicitamos asistencia por el siguiente requerimiento:',\n    '',\n    (c.desc || '').split('\\n---')[0].trim(),\n    '',\n    'Gracias,',\n    'Sistemas El Desembarco'\n  ].join('\\n');\n  out.push({ json: {\n    cardId: c.id,\n    cardName: c.name,\n    shortUrl: c.shortUrl,\n    mesa: cfg.mesa,\n    destino: cfg.destino,\n    asunto: ('[El Desembarco] ' + nombre).slice(0, 100) + ' (Ref ' + (((c.shortUrl || '').split('/c/')[1]) || c.id) + ')',\n    cuerpo,\n    attUrl: atts.length ? atts[0].url : '',\n    attList: atts.map(a => ({ url: a.url, name: a.fileName || a.name || 'adjunto', mime: a.mimeType || 'application/octet-stream' }))\n  } });\n}\nreturn out;"
            }
        },
