        {
            "id": "code-filtrar",
            "name": "Filtrar y Normalizar",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                220,
                0
            ],
            "parameters": {
                "jsCode": "// Recibe el push del bridge WhatsApp local. Filtra: token, trigger #req, dedupe.\nconst TOKEN = '660085b0160db3effde5cbb8fe4b6fc5cda3fe70ef79dfe7d959a419f2913d68';\n// Chats donde TODO mensaje es requerimiento (agregar JIDs de grupos dedicados aca):\nconst ALWAYS_CHATS = ['120363410062969047@g.us']; // SOPORTE SISTEMAS\nconst RE_TRIGGER = /^\\s*#(req|ticket|requerimiento)\\b[:\\-]?\\s*/i;\n\nconst sd = $getWorkflowStaticData('global');\nif (!Array.isArray(sd.seen)) sd.seen = [];\nconst out = [];\n\nfor (const item of $input.all()) {\n  const headers = item.json.headers || {};\n  const p = item.json.body || {};\n  if ((headers['x-bridge-token'] || '') !== TOKEN) continue;\n  if (p.eventType === 'reaction') continue;\n  const content = (p.content || '').trim();\n  const isAlways = ALWAYS_CHATS.includes(p.chatJID);\n  const m = content.match(RE_TRIGGER);\n  if (!m && !isAlways) continue;\n  const texto = m ? content.replace(RE_TRIGGER, '').trim() : content;\n  if (!texto && !p.mediaBase64) continue;\n\n  // Dedupe: por messageId si existe, sino hash de dia+chat+sender+contenido\n  let dedupeKey = p.messageId;\n  if (!dedupeKey) {\n    const key = `${new Date().toISOString().slice(0, 10)}|${p.chatJID}|${p.sender}|${content}`.slice(0, 500);\n    let hash = 0;\n    for (let i = 0; i < key.length; i++) hash = ((hash << 5) - hash + key.charCodeAt(i)) | 0;\n    dedupeKey = `h${hash}`;\n  }\n  if (sd.seen.includes(dedupeKey)) continue;\n  sd.seen.push(dedupeKey);\n  if (sd.seen.length > 300) sd.seen = sd.seen.slice(-200);\n\n  out.push({ json: {\n    texto,\n    sender: p.sender || '',\n    chatJID: p.chatJID || '',\n    isFromMe: !!p.isFromMe,\n    quotedContent: p.quotedContent || '',\n    quotedSender: p.quotedSender || '',\n    mediaBase64: p.mediaBase64 || '',\n    mimeType: p.mimeType || '',\n    mediaFilename: p.mediaFilename || '',\n    recibido: new Date().toISOString()\n  }});\n}\nreturn out;"
            }
        },
        {
            "id": "code-prompt",
            "name": "Armar Prompt Gemini",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                440,
                0
            ],
            "parameters": {
                "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const parts = [];\n  if (j.mediaBase64 && (j.mimeType || '').startsWith('image/')) {\n    parts.push({ inline_data: { mime_type: j.mimeType, data: j.mediaBase64 } });\n  }\n  const ctx = j.quotedContent ? `\\n\\nMensaje citado (contexto): \\\"${j.quotedContent}\\\"` : '';\n  parts.push({ text: `Sos el asistente de sistemas del grupo gastronomico El Desembarco (hamburgueserias: El Desembarco, Mr Tasty, Mila&Go; ~18 locales propios en Buenos Aires). Convertis requerimientos que llegan por WhatsApp en tickets de trabajo.\\n\\nRequerimiento recibido de ${j.sender}:\\n\\\"\\\"\\\"${j.texto}\\\"\\\"\\\"${ctx}\\n\\nSi hay una imagen adjunta, usala como contexto (ej: foto de equipo roto, pantalla con error, comprobante).\\n\\nDevolve SOLO JSON con:\\n- titulo: resumen imperativo, max 70 caracteres (ej: \\\"Reparar freidora en Palermo\\\")\\n- descripcion: el requerimiento completo, redactado claro, sin perder ningun detalle\\n- categoria: \\\"Mantenimiento\\\" | \\\"Equipamiento\\\" | \\\"Sistemas\\\" | \\\"Compras\\\" | \\\"RRHH\\\" | \\\"Proveedores\\\" | \\\"Otro\\\"\\n- prioridad: \\\"Alta\\\" (urgente / bloquea la operacion) | \\\"Media\\\" | \\\"Baja\\\"\\n- local: nombre del local/sucursal si se menciona (ej: Palermo, Nunez, Recoleta, Devoto, San Telmo, Caballito, Olivos, Pacheco, Quilmes, Nordelta, Microcentro, Hurlingham, Ramos, Martinez, Merlo, San Fernando, San Martin, Belgrano, Boedo, Pacifico), sino \\\"\\\"` });\n  const geminiBody = {\n    contents: [{ role: 'user', parts }],\n    generationConfig: {\n      responseMimeType: 'application/json',\n      responseSchema: {\n        type: 'object',\n        properties: {\n          titulo: { type: 'string' },\n          descripcion: { type: 'string' },\n          categoria: { type: 'string', enum: ['Mantenimiento', 'Equipamiento', 'Sistemas', 'Compras', 'RRHH', 'Proveedores', 'Otro'] },\n          prioridad: { type: 'string', enum: ['Alta', 'Media', 'Baja'] },\n          local: { type: 'string' }\n        },\n        required: ['titulo', 'descripcion', 'prioridad']\n      }\n    }\n  };\n  out.push({ json: { ...j, geminiBody } });\n}\nreturn out;"
            }
        },
        {
            "id": "http-gemini",
            "name": "Clasificar con Gemini",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.4,
            "position": [
                660,
                0
            ],
            "parameters": {
                "method": "POST",
                "url": "https://us-central1-aiplatform.googleapis.com/v1/projects/n8n-vertex-ai-495115/locations/us-central1/publishers/google/models/gemini-2.5-flash-lite:generateContent",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "googleApi",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify($json.geminiBody) }}",
                "options": {
                    "response": {
                        "response": {
                            "responseFormat": "json"
                        }
                    },
                    "timeout": 90000
                }
            },
            "credentials": {
                "googleApi": {
                    "id": "G57aSdJ8sznWrlnP",
                    "name": "Vertex AI - n8n-vertex-ai-495115"
                }
            },
            "retryOnFail": true,
            "maxTries": 2,
            "waitBetweenTries": 5000,
            "onError": "continueErrorOutput"
        },
        {
            "id": "code-parsear",
            "name": "Parsear Gemini",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                880,
                -100
            ],
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const src = $('Armar Prompt Gemini').item.json;\nlet t = {};\ntry {\n  const raw = $json.candidates?.[0]?.content?.parts?.[0]?.text || '';\n  t = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) { t = {}; }\nconst texto = src.texto || '(sin texto)';\nconst out = { ...src };\ndelete out.geminiBody;\nout.titulo = String(t.titulo || texto.slice(0, 70) || 'Requerimiento WhatsApp').slice(0, 100);\nout.descripcion = String(t.descripcion || texto);\nout.prioridad = ['Alta', 'Media', 'Baja'].includes(t.prioridad) ? t.prioridad : 'Media';\nout.categoria = t.categoria || 'Otro';\nout.local = t.local || '';\nreturn { json: out };"
            }
        },
        {
            "id": "code-fallback",
            "name": "Fallback sin IA",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                880,
                140
            ],
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "// Si Gemini falla, el ticket sale igual con el texto crudo.\nconst src = $('Armar Prompt Gemini').item.json;\nconst texto = src.texto || '(sin texto)';\nconst out = { ...src };\ndelete out.geminiBody;\nout.titulo = texto.slice(0, 70) || 'Requerimiento WhatsApp';\nout.descripcion = texto;\nout.prioridad = 'Media';\nout.categoria = 'Otro';\nout.local = '';\nreturn { json: out };"
            }
        },
        {
            "id": "code-card",
            "name": "Armar Card",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1100,
                0
            ],
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const j = $json;\nconst prio = j.prioridad === 'Alta' ? '\u00f0\u0178\u201d\u00b4' : j.prioridad === 'Baja' ? '\u00f0\u0178\u0178\u00a2' : '\u00f0\u0178\u0178\u00a1';\nconst name = `${prio} ${j.local ? '[' + j.local + '] ' : ''}${j.titulo}`;\nconst desc = [\n  j.descripcion,\n  '',\n  '---',\n  `**Solicitante:** ${j.sender}${j.isFromMe ? ' (Pablo)' : ''}`,\n  `**Chat:** ${j.chatJID}`,\n  `**Categoria:** ${j.categoria} \u00c2\u00b7 **Prioridad:** ${j.prioridad}${j.local ? ' \u00c2\u00b7 **Local:** ' + j.local : ''}`,\n  `**Recibido:** ${j.recibido}`,\n  '**Via:** WhatsApp \u00e2\u2020\u2019 n8n (auto)'\n].join('\\n');\nreturn { json: { ...j, cardName: name, cardDesc: desc } };"
            }
        },
