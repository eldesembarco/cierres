d: { type: 'string', enum: ['Alta', 'Media', 'Baja'] },\n          local: { type: 'string' }\n        },\n        required: ['titulo', 'descripcion', 'prioridad']\n      }\n    }\n  };\n  out.push({ json: { ...j, geminiBody } });\n}\nreturn out;"
                }
