        {
            "id": "code-adjunto",
            "name": "Preparar Adjunto",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1760,
                -100
            ],
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const card = $json;\nconst src = $('Armar Card').item.json;\nconst buf = Buffer.from(src.mediaBase64, 'base64');\nconst fileName = src.mediaFilename || 'adjunto-whatsapp';\nconst mime = src.mimeType || 'application/octet-stream';\nconst bin = await this.helpers.prepareBinaryData(buf, fileName, mime);\nreturn { json: { cardId: card.id, shortUrl: card.shortUrl }, binary: { data: bin } };"
            }
        },
