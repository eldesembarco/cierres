                "mode": "runOnceForEachItem",
                "jsCode": "// Si la card est\u00c3\u00a1 en una columna 'Pas\u00c3\u00b3 a Mesa...', al responder la mesa se mueve a 'Lo tom\u00c3\u00b3 ...'.\nconst src = $('Parsear Respuesta').item.json;\nconst idList = ($json && $json.idList) || '';\nconst MAP = {\n  '6a689b2b078eec227dc02ea5': '6a689b2c92e20b65c9e467c0', // Pas\u00c3\u00b3 Tango -> Lo tom\u00c3\u00b3 Tango\n  '6a689bcabc131c785ef97206': '6a68db9427fa9384d7e8b3d0'  // Pas\u00c3\u00b3 Ayres -> Lo tom\u00c3\u00b3 Ayres\n};\nreturn { json: { ...src, moveTo: MAP[idList] || '' } };"
