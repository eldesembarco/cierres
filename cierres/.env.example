# La base Neon es compartida con otros proyectos. Esta app vive en su propio
# schema "cierres" (no "public"), por eso el ?schema=cierres. El adapter pg en
# src/lib/db.ts y prisma/seed.ts pasa { schema: 'cierres' } explicitamente.
# Para migraciones/dev usar la URL DIRECTA (sin -pooler). En Vercel usar la POOLED.
DATABASE_URL="postgresql://user:password@host.sa-east-1.aws.neon.tech/neondb?sslmode=require&schema=cierres"
AUTH_SECRET=""
