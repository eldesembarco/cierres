generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Marca {
  id      Int     @id @default(autoincrement())
  nombre  String  @unique
  activo  Boolean @default(true)
  locales Local[]
  @@map("marcas")
}

model Local {
  id               Int               @id @default(autoincrement())
  nombre           String
  marca            Marca             @relation(fields: [marcaId], references: [id])
  marcaId          Int               @map("marca_id")
  direccion        String?
  ciudad           String?
  pais             String            @default("AR")
  moneda           String            @default("ARS")
  fondoFijoDefault Decimal           @default(0) @map("fondo_fijo_default") @db.Decimal(14, 2)
  // Sucursal correspondiente en Tango (ID_SUCURSAL). Sirve para consumir los cobros
  // reales del bridge (/cobros) y conciliarlos contra lo cargado. Null = sin mapear.
  tangoSucursalId  Int?              @unique @map("tango_sucursal_id")
  activo           Boolean           @default(true)
  mapeos           LocalPlataforma[]
  cierres          Cierre[]
  ventasApp        VentaApp[]
  usuarios         Usuario[]
  cierresTango     CierreTango[]
  movimientosCtaCte MovimientoCtaCte[]
  reposicionesFondoFijo ReposicionFondoFijo[]
  @@map("locales")
}

model Plataforma {
  id            Int               @id @default(autoincrement())
  nombre        String            @unique
  codigo        String            @unique
  activo        Boolean           @default(true)
  mapeos        LocalPlataforma[]
  ventasApp     VentaApp[]
  importaciones Importacion[]
  @@map("plataformas")
}

model LocalPlataforma {
  id                  Int        @id @default(autoincrement())
  local               Local      @relation(fields: [localId], references: [id])
  localId             Int        @map("local_id")
  plataforma          Plataforma @relation(fields: [plataformaId], references: [id])
  plataformaId        Int        @map("plataforma_id")
  restaurantIdExterno String     @map("restaurant_id_externo")
  nombreExterno       String?    @map("nombre_externo")
  activo              Boolean    @default(true)
  @@unique([plataformaId, restaurantIdExterno])
  @@map("local_plataforma")
}

enum Rol {
  encargado
  central
  admin
  contable
}

model Usuario {
  id           Int     @id @default(autoincrement())
  nombre       String
  email        String  @unique
  passwordHash String  @map("password_hash")
  rol          Rol
  local        Local?  @relation(fields: [localId], references: [id])
  localId      Int?    @map("local_id")
  activo       Boolean @default(true)
  @@map("usuarios")
}

enum EstadoCierre {
  borrador
  cerrado
}

model Cierre {
  id                 Int           @id @default(autoincrement())
  local              Local         @relation(fields: [localId], references: [id])
  localId            Int           @map("local_id")
  fecha              DateTime      @db.Date
  turno              Turno
  fondoFijo          Decimal       @default(0) @map("fondo_fijo") @db.Decimal(14, 2)
  montoZ             Decimal       @default(0) @map("monto_z") @db.Decimal(14, 2)
  efectivoDepositado Decimal       @default(0) @map("efectivo_depositado") @db.Decimal(14, 2)
  // Efectivo del día que NO se deposita porque queda en la caja chica del local para
  // recuperar/armar el fondo fijo. Baja el efectivo esperado (no genera falso faltante)
  // y sube el saldo del fondo fijo del local (aporte auto-financiado).
  retiroFondoFijo    Decimal       @default(0) @map("retiro_fondo_fijo") @db.Decimal(14, 2)
  notaCredito        Decimal       @default(0) @map("nota_credito") @db.Decimal(14, 2)
  cantidadTickets    Int?          @map("cantidad_tickets")
  estado             EstadoCierre  @default(borrador)
  nota               String?
  creadoPor          Int           @map("creado_por")
  creadoEn           DateTime      @default(now()) @map("creado_en")
  actualizadoEn      DateTime      @updatedAt @map("actualizado_en")
  cerradoPor         Int?          @map("cerrado_por")
  cerradoEn          DateTime?     @map("cerrado_en")
  ventas             CierreVenta[]
  tarjetas           CierreTarjeta[]
  detalles           CierreDetalle[]
  gastos             CierreGasto[]
  auditorias         CierreAuditoria[]
  movimientosCtaCte  MovimientoCtaCte[]
  @@unique([localId, fecha, turno])
  @@map("cierres")
}

model CierreAuditoria {
  id            Int      @id @default(autoincrement())
  cierre        Cierre   @relation(fields: [cierreId], references: [id], onDelete: Cascade)
  cierreId      Int      @map("cierre_id")
  usuarioId     Int      @map("usuario_id")
  usuarioNombre String   @map("usuario_nombre")
  accion        String
  observacion   String
  creadoEn      DateTime @default(now()) @map("creado_en")
  @@map("cierre_auditoria")
}

enum Turno {
  manana
  tarde
}

enum Canal {
  efectivo
  tarjetas
  rappi
  pedidosya
  pedidosya_efectivo
  mercado_pedidos
  mercadopago
  pvs_qr
  uber
  delivery_propio
  varios
}

enum TipoTarjeta {
  mastercard
  maestro
  visa_credito
  visa_debito
  amex
}

model CierreTarjeta {
  id       Int          @id @default(autoincrement())
  cierre   Cierre       @relation(fields: [cierreId], references: [id], onDelete: Cascade)
  cierreId Int          @map("cierre_id")
  tipo     TipoTarjeta
  monto    Decimal      @default(0) @db.Decimal(14, 2)
  lote     String?
  @@unique([cierreId, tipo])
  @@map("cierre_tarjetas")
}

model CierreVenta {
  id       Int     @id @default(autoincrement())
  cierre   Cierre  @relation(fields: [cierreId], references: [id], onDelete: Cascade)
  cierreId Int     @map("cierre_id")
  canal    Canal
  monto    Decimal @default(0) @db.Decimal(14, 2)
  @@unique([cierreId, canal])
  @@map("cierre_ventas")
}

model CierreDetalle {
  id         Int     @id @default(autoincrement())
  cierre     Cierre  @relation(fields: [cierreId], references: [id], onDelete: Cascade)
  cierreId   Int     @map("cierre_id")
  canal      Canal
  referencia String  @default("")
  importe    Decimal @default(0) @db.Decimal(14, 2)
  orden      Int     @default(0)
  @@index([cierreId, canal])
  @@map("cierre_detalle")
}

enum FormaPago {
  efectivo
  tarjeta
  transferencia
  otro
  cuenta_corriente
  fondo_fijo
}

model CierreGasto {
  id            Int        @id @default(autoincrement())
  cierre        Cierre     @relation(fields: [cierreId], references: [id], onDelete: Cascade)
  cierreId      Int        @map("cierre_id")
  tipo          String
  formaPago     FormaPago  @map("forma_pago")
  monto         Decimal    @default(0) @db.Decimal(14, 2)
  descripcion   String?
  comprobanteId Int?       @map("comprobante_id")
  facturaNumero String?    @map("factura_numero")
  facturaTotal  Decimal?   @map("factura_total") @db.Decimal(14, 2)
  orden         Int        @default(0)
  proveedor     Proveedor? @relation(fields: [proveedorId], references: [id])
  proveedorId   Int?       @map("proveedor_id")
  @@map("cierre_gasto")
}

// Catálogo de proveedores/terceros a los que la empresa les compra en cuenta
// corriente (les paga administración después). Global: un proveedor puede
// abastecer a varios locales.
model Proveedor {
  id          Int                @id @default(autoincrement())
  nombre      String
  activo      Boolean            @default(true)
  creadoEn    DateTime           @default(now()) @map("creado_en")
  gastos      CierreGasto[]
  movimientos MovimientoCtaCte[]
  @@map("proveedores")
}

// Libro de la cuenta corriente (lo que la empresa DEBE). Cada gasto cargado con
// forma de pago "cuenta_corriente" genera un movimiento pendiente. Vive en tabla
// propia (no en cierre_gasto) porque los gastos se borran+recrean al reeditar un
// cierre: los movimientos PAGADOS nunca se pisan; los pendientes se resincronizan.
model MovimientoCtaCte {
  id          Int        @id @default(autoincrement())
  local       Local      @relation(fields: [localId], references: [id])
  localId     Int        @map("local_id")
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
  proveedorId Int?       @map("proveedor_id")
  cierre      Cierre?    @relation(fields: [cierreId], references: [id], onDelete: SetNull)
  cierreId    Int?       @map("cierre_id")
  fecha       DateTime   @db.Date
  concepto    String
  descripcion String?
  monto       Decimal    @default(0) @db.Decimal(14, 2)
  pagado      Boolean    @default(false)
  pagadoEn    DateTime?  @map("pagado_en")
  pagadoPor   Int?       @map("pagado_por")
  creadoEn    DateTime   @default(now()) @map("creado_en")
  @@index([localId, pagado])
  @@index([cierreId])
  @@map("movimiento_cta_cte")
}

// Reposiciones del fondo fijo (caja chica) por local. El SALDO CORRIENTE del fondo
// fijo = fondoFijoDefault del local − Σ(gastos con formaPago='fondo_fijo') + Σ(reposiciones).
// Se computa SIEMPRE desde la suma actual (nunca acumulando un contador), igual que la
// cuenta corriente, para que reeditar cierres (que borran+recrean gastos) no doble-cuente.
model ReposicionFondoFijo {
  id          Int      @id @default(autoincrement())
  local       Local    @relation(fields: [localId], references: [id])
  localId     Int      @map("local_id")
  fecha       DateTime @db.Date
  monto       Decimal  @default(0) @db.Decimal(14, 2)
  descripcion String?
  creadoPor   Int      @map("creado_por")
  creadoEn    DateTime @default(now()) @map("creado_en")
  @@index([localId])
  @@map("reposicion_fondo_fijo")
}

// Cierre de turno crudo recibido por correo desde Tango (lo postea n8n, una
// casilla por local → localId). Es la fuente de datos "real" para el botón
// "Importar desde Tango": se guarda tal cual se parsea el PDF, por (local, fecha, turno).
model CierreTango {
  id              Int      @id @default(autoincrement())
  local           Local    @relation(fields: [localId], references: [id])
  localId         Int      @map("local_id")
  fecha           DateTime @db.Date
  turno           Turno
  ventas          Json
  montoZ          Decimal  @default(0) @map("monto_z") @db.Decimal(14, 2)
  cantidadTickets Int?     @map("cantidad_tickets")
  // Anulaciones y devoluciones del cierre (control/auditoría del admin). Nullable:
  // los cierres viejos no las tienen, y el PDF puede no traer esas secciones.
  anulacionesAfectanCaja Decimal? @map("anulaciones_afectan_caja") @db.Decimal(14, 2)
  anulacionesTotal       Decimal? @map("anulaciones_total") @db.Decimal(14, 2)
  devolucionesTotal      Decimal? @map("devoluciones_total") @db.Decimal(14, 2)
  recibidoEn      DateTime @default(now()) @map("recibido_en")
  @@unique([localId, fecha, turno])
  @@map("cierre_tango")
}

model Comprobante {
  id       Int      @id @default(autoincrement())
  nombre   String
  mime     String
  data     Bytes
  creadoEn DateTime @default(now()) @map("creado_en")
  @@map("comprobantes")
}

model VentaApp {
  id              Int         @id @default(autoincrement())
  local           Local       @relation(fields: [localId], references: [id])
  localId         Int         @map("local_id")
  plataforma      Plataforma  @relation(fields: [plataformaId], references: [id])
  plataformaId    Int         @map("plataforma_id")
  fecha           DateTime    @db.Date
  pedidosEfectivo Int         @default(0) @map("pedidos_efectivo")
  pedidosOnline   Int         @default(0) @map("pedidos_online")
  ventaEfectivo   Decimal     @default(0) @map("venta_efectivo") @db.Decimal(14, 2)
  ventaOnline     Decimal     @default(0) @map("venta_online") @db.Decimal(14, 2)
  // Comisión retenida por la plataforma (ej. Mercado Pago). 0 para PedidosYa/otras.
  comision        Decimal     @default(0) @db.Decimal(14, 2)
  importacion     Importacion @relation(fields: [importacionId], references: [id])
  importacionId   Int         @map("importacion_id")
  creadoEn        DateTime    @default(now()) @map("creado_en")
  actualizadoEn   DateTime    @updatedAt @map("actualizado_en")
  @@unique([localId, plataformaId, fecha])
  @@map("ventas_app")
}

model Importacion {
  id             Int                    @id @default(autoincrement())
  plataforma     Plataforma             @relation(fields: [plataformaId], references: [id])
  plataformaId   Int                    @map("plataforma_id")
  fechaReporte   DateTime               @db.Date @map("fecha_reporte")
  archivoNombre  String                 @map("archivo_nombre")
  filasTotal     Int                    @map("filas_total")
  filasMapeadas  Int                    @map("filas_mapeadas")
  filasSinMapear Int                    @map("filas_sin_mapear")
  subidoPor      Int                    @map("subido_por")
  creadoEn       DateTime               @default(now()) @map("creado_en")
  ventasApp      VentaApp[]
  sinMapear      ImportacionSinMapear[]
  @@map("importaciones")
}

model ImportacionSinMapear {
  id                  Int         @id @default(autoincrement())
  importacion         Importacion @relation(fields: [importacionId], references: [id], onDelete: Cascade)
  importacionId       Int         @map("importacion_id")
  plataformaId        Int         @map("plataforma_id")
  restaurantIdExterno String      @map("restaurant_id_externo")
  nombreExterno       String?     @map("nombre_externo")
  ventaEfectivo       Decimal     @default(0) @map("venta_efectivo") @db.Decimal(14, 2)
  ventaOnline         Decimal     @default(0) @map("venta_online") @db.Decimal(14, 2)
  @@map("importacion_sin_mapear")
}
